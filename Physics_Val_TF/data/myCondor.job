Universe           = vanilla
Notification       = Never
Executable         = $(macroDir)/runHFreco.sh
Arguments          = $(dstList) $(nEvents) $(outDir) $(nSkip)
Environment        = "MACRO_DIR=$(macroDir)"
Initialdir         = $(submitDir)
request_memory                 = 1800MB
retry_request_memory_increase  = RequestMemory + 400
retry_request_memory_max       = 3600MB
PeriodicHold       = (NumJobStarts>=1 && JobStatus == 1 && !(ON_EVICT_CHECK_RequestMemory_REQUIREMENTS))
Priority           = 20
job_lease_duration = 3600
#Output             = $(logDir)/job-$(Cluster)-$(Process).out
#Error              = $(logDir)/job-$(Cluster)-$(Process).err
Log                = /tmp/job-HF-$(Cluster)-$(Process).log
nEvents    = 0
nSkip      = 0

# Locations: the directory this file is in (submitCondorJobs.sh runs from there)
submitDir  = $ENV(PWD)
macroDir   = $(submitDir)/macro
outDir     = $(submitDir)/root/
#logDir     = $(submitDir)/log

# The queue line is rewritten by submitCondorJobs.sh for each run: one job per sublist of the run
Queue dstList from /gpfs/mnt/gpfs02/sphenix/user/cdean/software/TrackingAnalysis/Physics_Val_TF/data/fileLists/run3pp_ana581_2026p005_v001_DST_TRKR_TRACKS/jobs/run79516.txt
